# Copy to .env.local. Public values are included in the app bundle.
EXPO_PUBLIC_BACKEND=supabase
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
EXPO_PUBLIC_CLOUDINARY_CLOUD_NAME=

# Set EXPO_PUBLIC_BACKEND=local only for an explicit offline demo.
# Never put a service-role key or Cloudinary API secret here.
