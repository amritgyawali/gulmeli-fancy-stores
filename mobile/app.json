{
  "expo": {
    "name": "Gulmeli Fancy Stores",
    "slug": "gulmeli-fancy-store",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "gulmeli",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.gulmeli.fancystore",
      "buildNumber": "1",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.gulmeli.fancystore",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#f85606",
        "foregroundImage": "./assets/adaptive-icon.png",
        "monochromeImage": "./assets/monochrome-icon.png"
      },
      "icon": "./assets/icon.png",
      "predictiveBackGestureEnabled": true
    },
    "web": {
      "output": "static"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#f4f4f4",
          "image": "./assets/splash-icon.png",
          "imageWidth": 200
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Gulmeli Fancy Stores to choose a profile or reference photo.",
          "cameraPermission": "Allow Gulmeli Fancy Stores to take a reference photo.",
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
