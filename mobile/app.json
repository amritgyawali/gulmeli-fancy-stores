{
  "expo": {
    "name": "Gulmeli Fancy Stores",
    "slug": "gulmeli-fancy-store",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "gulmeli",
    "userInterfaceStyle": "light",
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.gulmeli.fancystore",
      "buildNumber": "1",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.gulmeli.fancystore",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#f85606",
        "foregroundImage": "./assets/adaptive-icon.png",
        "monochromeImage": "./assets/monochrome-icon.png"
      },
      "icon": "./assets/icon.png",
      "predictiveBackGestureEnabled": true
    },
    "web": {
      "output": "static"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#f4f4f4",
          "image": "./assets/splash-icon.png",
          "imageWidth": 200
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Gulmeli Fancy Stores to choose a profile or reference photo.",
          "cameraPermission": "Allow Gulmeli Fancy Stores to take a reference photo.",
          "microphonePermission": false
        }
      ],
      "expo-sqlite",
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Gulmeli Fancy Stores to take product photos for reviews and profile pictures."
        }
      ],
      "expo-local-authentication",
      [
        "expo-notifications",
        {
          "color": "#f85606"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow Gulmeli Fancy Stores to show delivery areas and store locations near you.",
          "locationAlwaysAndWhenInUsePermission": "Allow Gulmeli Fancy Stores to show delivery areas and store locations near you."
        }
      ],
      [
        "@stripe/stripe-react-native",
        {
          "enableGooglePay": false,
          "merchantId": ""
        }
      ],
      [
        "@sentry/react-native/expo",
        {
          "url": "https://sentry.io/",
          "project": "gulmeli-fancy-store",
          "organization": "your-sentry-organization"
        }
      ],
      "expo-web-browser"
    ],
    "extra": {
      "mapboxAccessToken": "",
      "eas": {
        "projectId": "85a74ee9-4241-4e1e-a05b-3cf6511ca015"
      }
    },
    "experiments": {
      "typedRoutes": true
    }
  }
}
